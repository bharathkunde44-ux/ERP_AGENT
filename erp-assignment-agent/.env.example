# =================================================================
# COLLEGE ERP ASSIGNMENT AGENT - CONFIGURATION TEMPLATE
# Copy this file to .env and configure your credentials
# =================================================================

# -----------------------------------------------------------------
# 1. Groq LLM Brain Configuration
# -----------------------------------------------------------------
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------
# 2. ERP Portal Credentials
# -----------------------------------------------------------------
# Sidus ERP or Mock ERP
ERP_PORTAL_URL=https://www.sidus.net/modules/assessments/assessments
ERP_USERNAME=your_email@example.com
ERP_PASSWORD=your_password
ASSIGNMENTS_DIR=C:\personal\2ND_YEAR_TERM_2

# -----------------------------------------------------------------
# 3. Email Alerts Configuration (Nodemailer / Gmail SMTP)
# -----------------------------------------------------------------
# For Gmail, generate an App Password: Google Account -> Security -> App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
ALERT_RECIPIENT_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------
# 4. WhatsApp Alerts (Meta WhatsApp Cloud API)
# -----------------------------------------------------------------
# From Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_RECIPIENT_PHONE=916309049745

# -----------------------------------------------------------------
# 5. Two-Way WhatsApp Webhook Configuration
# -----------------------------------------------------------------
WEBHOOK_PORT=3005
WHATSAPP_VERIFY_TOKEN=sidus_erp_verify_2026

# -----------------------------------------------------------------
# 6. Agent Safety & Autonomous Thresholds
# -----------------------------------------------------------------
# Minimum AI matching confidence percentage (0-100) required to trigger auto-submission
AUTO_SUBMIT_CONFIDENCE_THRESHOLD=85

# Auto-submit if deadline is within this number of hours (e.g. 24 = submit within last 24h)
HOURS_BEFORE_DEADLINE_TO_SUBMIT=48

# Run schedule in daemon mode (standard cron expression; default: every 30 minutes)
CRON_SCHEDULE=*/30 * * * *

# Browser visibility (set to true for headless background runs, false to watch Playwright)
HEADLESS_BROWSER=false
AGENT_HEADLESS=false
DRY_RUN=false
MOCK_SERVER_PORT=3000
